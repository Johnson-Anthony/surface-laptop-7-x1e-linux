@@ -0,0 +1,128 @@
+# Frame reader for the Surface Laptop 7 IR camera (ST VD55G0 behind Qualcomm CAMSS).
+# The raw CAMSS video node needs its media links and formats set before streaming, and
+# the IR flood LED is fired by the sensor's own strobe output (V4L2 control led_mode),
+# so frames are streamed through v4l2-ctl instead of OpenCV's V4L2 backend.
+
+import atexit
+import ctypes
+import os
+import select
+import signal
+import subprocess
+import time
+
+import numpy as np
+
+SENSOR = "vd55g0 8-0010"
+VIDEO = "msm_vfe1_video0"
+WIDTH = 644
+HEIGHT = 604
+LINKS = [
+	'"msm_csiphy0":1->"msm_csid0":0[0]',
+	'"msm_csiphy0":1->"msm_csid1":0[1]',
+	'"msm_csid1":1->"msm_vfe1_rdi0":0[1]',
+]
+PADS = ['"%s":0' % SENSOR, '"msm_csiphy0":0', '"msm_csid1":0', '"msm_vfe1_rdi0":0']
+
+
+def _die_with_parent():
+	"""Stop v4l2-ctl, and with it the strobe, if the Howdy process is killed"""
+	ctypes.CDLL("libc.so.6", use_errno=True).prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG
+
+
+class camss_ir_reader:
+	def __init__(self, media_device, exposure=600, gain=8, frame_timeout=1.5):
+		self.media = media_device
+		self.exposure = exposure
+		self.gain = gain
+		self.frame_timeout = frame_timeout
+		self.proc = None
+		self.subdev = None
+		self.restarted = False
+		atexit.register(self.release)
+		self._setup()
+		self._start()
+
+	def _run(self, *args):
+		return subprocess.run(args, check=True, capture_output=True, text=True).stdout
+
+	def _setup(self):
+		for link in LINKS:
+			self._run("media-ctl", "-d", self.media, "-l", link)
+		for pad in PADS:
+			self._run("media-ctl", "-d", self.media, "-V",
+				"%s[fmt:Y8_1X8/%dx%d field:none]" % (pad, WIDTH, HEIGHT))
+
+		self.video = self._run("media-ctl", "-d", self.media, "-e", VIDEO).strip()
+		self.subdev = self._run("media-ctl", "-d", self.media, "-e", SENSOR).strip()
+
+		self._run("v4l2-ctl", "-d", self.video,
+			"--set-fmt-video=width=%d,height=%d,pixelformat=GREY" % (WIDTH, HEIGHT))
+		fmt = self._run("v4l2-ctl", "-d", self.video, "--get-fmt-video")
+		self.bpl = WIDTH
+		for line in fmt.splitlines():
+			if "Bytes per Line" in line:
+				self.bpl = int(line.split(":")[1])
+		self.frame_size = self.bpl * HEIGHT
+
+		# Manual exposure keeps the background dark so the strobe-lit face dominates
+		self._run("v4l2-ctl", "-d", self.subdev, "-c", "auto_exposure=1",
+			"-c", "exposure=%d" % self.exposure, "-c", "analogue_gain=%d" % self.gain,
+			"-c", "led_mode=1")
+
+	def _start(self):
+		self.proc = subprocess.Popen(
+			["v4l2-ctl", "-d", self.video, "--stream-mmap", "--stream-count=0", "--stream-to=-"],
+			stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, preexec_fn=_die_with_parent)
+
+	def _stop(self):
+		if self.proc is None:
+			return
+		self.proc.terminate()
+		try:
+			self.proc.wait(timeout=2)
+		except subprocess.TimeoutExpired:
+			self.proc.kill()
+			self.proc.wait()
+		self.proc = None
+
+	def _read_exact(self, size):
+		fd = self.proc.stdout.fileno()
+		buf = bytearray()
+		deadline = time.monotonic() + self.frame_timeout
+		while len(buf) < size:
+			remaining = deadline - time.monotonic()
+			if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
+				return None
+			chunk = os.read(fd, size - len(buf))
+			if not chunk:
+				return None
+			buf += chunk
+		return bytes(buf)
+
+	def read(self):
+		data = self._read_exact(self.frame_size)
+		# CAMSS sometimes stalls on a stream started right after another one
+		if data is None and not self.restarted:
+			self.restarted = True
+			self._stop()
+			self._start()
+			data = self._read_exact(self.frame_size)
+		if data is None:
+			return False, None
+
+		gray = np.frombuffer(data, np.uint8).reshape(HEIGHT, self.bpl)[:, :WIDTH]
+		# Howdy converts frames with COLOR_BGR2GRAY, so hand it three channels
+		return True, np.repeat(gray[:, :, np.newaxis], 3, axis=2)
+
+	def grab(self):
+		self.read()
+
+	def set(self, prop, value):
+		pass
+
+	def release(self):
+		self._stop()
+		if self.subdev:
+			subprocess.run(["v4l2-ctl", "-d", self.subdev, "-c", "led_mode=0", "-c", "auto_exposure=0"],
+				stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
