#
# Surface Laptop 7 (X1E80100) options for a 7.3 kernel with patches/kernel-7.3, as a
# kconfig fragment on top of a distribution config. Tested base: Ubuntu's
# config-7.3.0-9-generic (in linux-buildinfo-7.3.0-9-generic 7.3.0-9.9).
#
#   scripts/kconfig/merge_config.sh -m .config sl7.fragment && make olddefconfig
#
# tools/kernel/make-config --base FILE does both. The config this machine actually runs
# is config-7.3.0-sl7 next to this file; this fragment is for starting from another base.

# --- Needed by this machine ---------------------------------------------------------
# HID over SPI for the touchpad and touchscreen. The symbol comes from the ItsLucas
# kit (0002, 0004); without the kit it does not exist.
CONFIG_SPI_HID=m
# Qualcomm crypto engine. It has to bind so both qnoc-x1e80100 interconnects reach
# sync_state (ItsLucas 0026/0027 remove the BROKEN mark; it registers no algorithms).
CONFIG_CRYPTO_DEV_QCE=m
# PDC wakeup controller and TLMM pin controller built in: the lid wakes the laptop
# from deep sleep through them. Ubuntu builds the pin controller as a module; the deep
# sleep results were measured with it built in, and =m was not tested.
CONFIG_QCOM_PDC=y
CONFIG_PINCTRL_X1E80100=y
# Audio macros, SoC sleep statistics, the Surface Aggregator user-space interface and
# the camera subsystem. Ubuntu already has these; listed for other bases.
CONFIG_SND_SOC_LPASS_VA_MACRO=m
CONFIG_SND_SOC_LPASS_TX_MACRO=m
CONFIG_SND_SOC_LPASS_RX_MACRO=m
CONFIG_SND_SOC_LPASS_WSA_MACRO=m
CONFIG_QCOM_STATS=m
CONFIG_SURFACE_AGGREGATOR_CDEV=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m

# --- Release name: 7.3.0-sl7 (with patches/kernel-7.3/build/0001) -------------------
CONFIG_LOCALVERSION="-sl7"
# CONFIG_LOCALVERSION_AUTO is not set

# --- linux-source workaround ----------------------------------------------------------
# Ubuntu's config points these at debian/canonical-*.pem, which the linux-source
# package does not ship. Empty means only the build's own module signing key.
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""

# --- Build host workarounds and choices -----------------------------------------------
# The build host (Debian 13) has rustc 1.85, too old for this kernel's Rust support,
# and no pahole, so no BTF. No debug info keeps the build and the packages small.
# With a newer rustc and pahole installed you can drop this block.
# CONFIG_RUST is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set

# --- Qualcomm and Surface options carried from Ubuntu's 7.3 config --------------------
# The shipped config was built from an older 7.0 config, and these are the Qualcomm,
# Surface, audio and camera options Ubuntu's 7.3 config enables that it lacked. Most
# are for other SoCs. On an Ubuntu base they change nothing.
CONFIG_QCOM_PPE=m
CONFIG_HW_RANDOM_QCOM=m
CONFIG_PINCTRL_MSM8917=m
CONFIG_PINCTRL_MILOS_LPASS_LPI=m
CONFIG_PINCTRL_SDM660_LPASS_LPI=m
CONFIG_PINCTRL_SDM670_LPASS_LPI=m
CONFIG_PINCTRL_SM6350_LPASS_LPI=m
CONFIG_BATTERY_CHARGER_SURFACE_RT=m
CONFIG_SENSORS_SURFACE_TEMP=m
CONFIG_QCOM_SPMI_MBG_TM=m
CONFIG_QCOM_SPMI_ADC_TM5_GEN3=m
CONFIG_SND_SOC_QCOM_OFFLOAD_UTILS=m
CONFIG_SND_SOC_SDCA=m
CONFIG_SND_SOC_SDCA_HID=y
CONFIG_SND_SOC_SDCA_IRQ=y
CONFIG_SND_SOC_SDCA_FDL=y
CONFIG_SND_SOC_SDCA_CLASS=m
CONFIG_SND_SOC_SDCA_CLASS_FUNCTION=m
CONFIG_SND_SOC_WSA885X=m
CONFIG_UCSI_HUAWEI_GAOKUN=m
CONFIG_EC_QCOM_HAMOA=m
CONFIG_AMD_MBV_BRAM_REMOTEPROC=m
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_PHY_QCOM_QMP_PCIE_MULTIPHY=m
CONFIG_PHY_QCOM_M31_EUSB=m
CONFIG_QCOMTEE=m
CONFIG_INTERCONNECT_QCOM_ELIZA=m
CONFIG_INTERCONNECT_QCOM_GLYMUR=m
CONFIG_INTERCONNECT_QCOM_HAWI=m
CONFIG_INTERCONNECT_QCOM_NORD=m
CONFIG_INTERCONNECT_QCOM_SHIKRA=m
CONFIG_INTERCONNECT_QCOM_MILOS=y
CONFIG_INTERCONNECT_QCOM_SM8750=m
