From: Anthony Johnson <105193579+Johnson-Anthony@users.noreply.github.com>
Date: Sun, 25 Oct 2026 20:33:36 +0000
Subject: [PATCH 3/3] recorders: add get() for frame size to camss_ir reader

compare.py reads CAP_PROP_FRAME_WIDTH/HEIGHT from the reader to compute its
scaling factor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 howdy/src/recorders/camss_ir_reader.py | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/howdy/src/recorders/camss_ir_reader.py b/howdy/src/recorders/camss_ir_reader.py
index 172526e..d62d626 100644
--- a/howdy/src/recorders/camss_ir_reader.py
+++ b/howdy/src/recorders/camss_ir_reader.py
@@ -11,6 +11,7 @@ import signal
 import subprocess
 import time
 
+import cv2
 import numpy as np
 
 SENSOR = "vd55g0 8-0010"
@@ -119,7 +120,15 @@ class camss_ir_reader:
 	def grab(self):
 		self.read()
 
+	def get(self, prop):
+		if prop == cv2.CAP_PROP_FRAME_WIDTH:
+			return WIDTH
+		if prop == cv2.CAP_PROP_FRAME_HEIGHT:
+			return HEIGHT
+		return 0
+
 	def set(self, prop, value):
+		# Size, format and exposure are fixed by this reader
 		pass
 
 	def release(self):
